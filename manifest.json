{
  "schemaVersion": 1,
  "id": "dev.thabopal.nexushub-dashboard",
  "name": "NexusHub Dashboard",
  "version": "0.7.0-alpha.3",
  "author": "Thabo Pali",
  "license": "MIT",
  "description": "A modular personal dashboard, control center, and desktop dock for Omarchy.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "NexusHub",
    "category": "Dashboard",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "dockEnabled": true,
      "widgetsEnabled": true,
      "activeProfile": "custom",
      "systemMonitorEnabled": true,
      "weatherEnabled": true,
      "githubActivityEnabled": true,
      "projectPulseEnabled": true,
      "footballEnabled": true,
      "newsEnabled": true,
      "footballApiKey": "",
      "dockOrder": ["browser", "files", "mail", "terminal", "editor", "spotify", "docker"],
      "dockHidden": []
    },
    "schema": [
      {
        "key": "dockEnabled",
        "type": "boolean",
        "label": "Show NexusHub desktop dock",
        "defaultValue": true
      },
      {
        "key": "widgetsEnabled",
        "type": "boolean",
        "label": "Show NexusHub desktop widgets",
        "defaultValue": true,
        "description": "Master switch for all desktop cards (System Monitor, Weather, Football, News). The per-card switches below are remembered while this is off."
      },
      {
        "key": "systemMonitorEnabled",
        "type": "boolean",
        "label": "Show System Monitor",
        "defaultValue": true
      },
      {
        "key": "weatherEnabled",
        "type": "boolean",
        "label": "Show Weather",
        "defaultValue": true
      },
      {
        "key": "githubActivityEnabled",
        "type": "boolean",
        "label": "Show GitHub Activity",
        "defaultValue": true
      },
      {
        "key": "projectPulseEnabled",
        "type": "boolean",
        "label": "Show Project Pulse",
        "defaultValue": true
      },
      {
        "key": "footballEnabled",
        "type": "boolean",
        "label": "Show Football Fixtures",
        "defaultValue": true
      },
      {
        "key": "newsEnabled",
        "type": "boolean",
        "label": "Show Top News",
        "defaultValue": true
      },
      {
        "key": "footballApiKey",
        "type": "string",
        "label": "football-data.org API key",
        "defaultValue": "",
        "description": "Free key from football-data.org/client/register. Required for the football widget; it shows a placeholder until this is set. Switch between EPL and Champions League with the tabs on the card itself."
      }
    ]
  }
}
