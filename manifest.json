{
  "schemaVersion": 1,
  "id": "dev.thabopal.nexushub-dashboard",
  "name": "NexusHub Dashboard",
  "version": "0.3.0-alpha.1",
  "author": "Thabo Pali",
  "license": "MIT",
  "description": "A modular personal dashboard, control center, and desktop dock for Omarchy.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "NexusHub",
    "category": "Dashboard",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "dockEnabled": true
    },
    "schema": [
      {
        "key": "dockEnabled",
        "type": "boolean",
        "label": "Show NexusHub desktop dock",
        "defaultValue": true
      }
    ]
  }
}
