{
  "schemaVersion": 1,
  "id": "dev.thabopal.nexushub-dashboard",
  "name": "NexusHub Dashboard",
  "version": "0.7.0-alpha.2",
  "author": "Thabo Pali",
  "license": "MIT",
  "description": "A modular personal dashboard, control center, and desktop dock for Omarchy.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "NexusHub",
    "category": "Dashboard",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "dockEnabled": true,
      "activeProfile": "custom",
      "systemMonitorEnabled": true,
      "weatherEnabled": true,
      "githubActivityEnabled": true,
      "projectPulseEnabled": true,
      "dockOrder": ["browser", "files", "mail", "terminal", "editor", "spotify", "docker"],
      "dockHidden": []
    },
    "schema": [
      {
        "key": "dockEnabled",
        "type": "boolean",
        "label": "Show NexusHub desktop dock",
        "defaultValue": true
      },
      {
        "key": "systemMonitorEnabled",
        "type": "boolean",
        "label": "Show System Monitor",
        "defaultValue": true
      },
      {
        "key": "weatherEnabled",
        "type": "boolean",
        "label": "Show Weather",
        "defaultValue": true
      },
      {
        "key": "githubActivityEnabled",
        "type": "boolean",
        "label": "Show GitHub Activity",
        "defaultValue": true
      },
      {
        "key": "projectPulseEnabled",
        "type": "boolean",
        "label": "Show Project Pulse",
        "defaultValue": true
      }
    ]
  }
}
